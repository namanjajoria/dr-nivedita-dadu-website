# Copy this file to .env and fill in the values. Never commit .env.

# ---- Runtime ---------------------------------------------------------------
# development | production
NODE_ENV=development
PORT=3000

# ---- SEO / URLs ------------------------------------------------------------
# Public origin used for canonical URLs, Open Graph tags, robots.txt and sitemap.xml.
# Production must be the final https domain (no path), e.g. https://www.drniveditadadu.com
# The server refuses to start in production with a localhost or http origin.
SITE_URL=http://localhost:3000

# Allow search engines to index the site. Defaults to true in production and false
# everywhere else; always false for localhost. Set false on staging servers.
# SEO_ALLOW_INDEXING=true

# ---- Hosting ---------------------------------------------------------------
# Set when running behind a reverse proxy or load balancer (usually 1) so rate
# limiting sees the real visitor IP.
TRUST_PROXY=false

# ---- Forms -----------------------------------------------------------------
# Secret for signing anti-bot form tokens. Required in production (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=

# Submissions allowed per IP address per window (shared by all forms).
FORM_RATE_LIMIT_WINDOW_MINUTES=15
FORM_RATE_LIMIT_MAX=10

# ---- Email delivery for form submissions (SMTP) -----------------------------
# Leave SMTP_HOST empty until credentials are available. In development submissions
# are then printed to the console; in production the forms answer "temporarily unavailable".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address (must be allowed by the SMTP provider) and the clinic inbox that receives submissions.
MAIL_FROM=
MAIL_TO=

# ---- External API (wired, switched off by default) ---------------------------
# When API_BASE_URL is empty, form submissions are delivered by email/console as
# before and nothing calls out. Set it to turn forwarding on - that is the only
# change required.
#
# WARNING: submissions are written to whatever database sits behind this URL, so
# never point it at the production API while testing - that would create real
# leads in live data. Use the local Dr Nivedita API or its staging environment:
#   API_BASE_URL=http://localhost:4000
API_BASE_URL=
API_TIMEOUT_MS=10000
