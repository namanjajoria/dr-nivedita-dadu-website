    },
    {
        "k":  "h2",
        "runs":  [
                     {
                         "t":  "5. Ideal Candidates",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Anyone who wants long-term hair reduction but has been nervous about pain is a good fit. It also suits people with medium to dark skin who were told older lasers weren\u0027t safe for them, and those who want larger areas like the legs or back done in reasonable time. Men often use it for beard shaping or back and chest hair.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Things to know:",
                         "b":  true
                     },
                     {
                         "t":  " Laser targets hair pigment, so very light, grey or blonde hair generally responds less well than dark hair, even with the Alexandrite wavelength. Hormonal areas like the upper lip and chin may need more sessions.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "h2",
        "runs":  [
                     {
                         "t":  "6. Process \u0026 Techniques",
                         "b":  false
