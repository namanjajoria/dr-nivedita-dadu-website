        "k":  "li",
        "runs":  [
                     {
                         "t":  "Treatment:",
                         "b":  true
                     },
                     {
                         "t":  " The cooled handpiece glides over the skin continuously. Small areas like the upper lip take a few minutes, while full legs or the back take around 45 to 60 minutes.",
                         "b":  false
