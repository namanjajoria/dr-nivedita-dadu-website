                 ]
    },
    {
        "k":  "li",
        "runs":  [
                     {
                         "t":  "Session 1:",
                         "b":  true
                     },
                     {
                         "t":  " around 10 to 20% less hair, with some shedding in 2 to 3 weeks",
                         "b":  false
                     }
                 ]
    },
