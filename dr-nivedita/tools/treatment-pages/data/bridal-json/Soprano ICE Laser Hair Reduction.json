    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: What makes Soprano ICE different from other lasers?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. It combines three wavelengths, keeps the handpiece moving and cools the skin the whole time. That makes it more comfortable and better suited to darker skin than many older lasers.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: Does Soprano ICE hurt?",
                         "b":  true
