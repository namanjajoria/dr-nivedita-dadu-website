        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: When will I see results?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. Treated hair starts shedding within one to two weeks. The reduction becomes clearer with each session.",
