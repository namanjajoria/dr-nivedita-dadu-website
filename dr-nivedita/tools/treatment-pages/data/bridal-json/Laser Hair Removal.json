    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: How many sessions of laser hair removal will I need?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. Usually 6 to 8, spaced four to six weeks apart. It varies with the area, hair density and skin type.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: Is laser hair removal permanent?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. It gives long-lasting reduction rather than a guarantee that no hair will ever return. Some people need a maintenance session once or twice a year.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: Does it hurt?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. Most people describe it as warmth, not pain, especially with cooling systems like Soprano ICE.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Q: Can women remove facial hair with laser?",
                         "b":  true
                     },
                     {
                         "t":  " \nAns. Yes. Upper lip, chin and full face treatments are common and considered safe when done correctly.",
                         "b":  false
                     }
                 ]
    },
