                     {
                         "t":  "7. Process \u0026 Techniques",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "li",
        "runs":  [
                     {
                         "t":  "Consultation:",
                         "b":  true
                     },
                     {
                         "t":  " Your skin tone, hair type and the areas you want treated are assessed, and the right laser is chosen.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "li",
        "runs":  [
                     {
                         "t":  "Prep:",
                         "b":  true
                     },
                     {
                         "t":  " Shave the area before your session. Avoid waxing or threading, because the laser needs the hair root in place to work.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "li",
        "runs":  [
                     {
                         "t":  "Treatment:",
                         "b":  true
                     },
                     {
                         "t":  " The laser is moved over the area in passes. With cooling systems like Soprano ICE, most people feel warmth rather than pain.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "li",
        "runs":  [
                     {
                         "t":  "After the session:",
                         "b":  true
                     },
                     {
                         "t":  " Treated hairs start shedding within one to two weeks.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "How many sessions?",
                         "b":  true
                     },
                     {
                         "t":  " Most areas need 6 to 8 sessions, spaced about four to six weeks apart. Beard shaping usually needs 4 to 6. The reduction becomes more visible with each sitting. Because hormones can wake up dormant follicles later on, a maintenance session once or twice a year may be needed.",
                         "b":  false
                     }
                 ]
    },
    {
        "k":  "p",
        "runs":  [
                     {
                         "t":  "Between sessions:",
                         "b":  true
                     },
                     {
                         "t":  " Shaving is fine. Waxing and threading are not. ",
                         "b":  false
                     },
                     {
                         "t":  "(Session duration, downtime, sun-care advice and possible side effects such as temporary redness are not listed on the live page: please confirm these with the clinic before publishing.)",
                         "b":  false
                     }
                 ]
    },
